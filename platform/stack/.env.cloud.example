# Copy to platform/stack/.env.cloud before deploying on a remote Linux host.

# Public ingress
ARKAB2B_PUBLIC_BIND_ADDRESS=0.0.0.0
ARKAB2B_PRIVATE_BIND_ADDRESS=127.0.0.1
ARKAB2B_API_GATEWAY_PORT=8080

# Optional host ports (not exposed in docker-compose.cloud.yml except gateway)
ARKAB2B_POSTGRES_PORT=55432
ARKAB2B_REDIS_PORT=56379
ARKAB2B_KAFKA_PORT=59092
ARKAB2B_CONFIG_SERVER_PORT=8888
ARKAB2B_EUREKA_SERVER_PORT=8761
ARKAB2B_IAM_PORT=8081
ARKAB2B_DIRECTORY_PORT=8082
ARKAB2B_CATALOG_PORT=8083
ARKAB2B_INVENTORY_PORT=8084
ARKAB2B_ORDER_PORT=8085
ARKAB2B_NOTIFICATION_PORT=8086
ARKAB2B_REPORTING_PORT=8087

# Internal advertised host for local-only listener (base compose compatibility)
ARKAB2B_KAFKA_ADVERTISED_HOST=localhost

# Host path where JWT key material is mounted for identity-access-service
# Use an absolute path in remote servers for predictability.
APP_SECRETS_HOST_DIR=./platform/secrets/cloud

# Startup tuning
ARKAB2B_READY_MAX_ATTEMPTS=240
ARKAB2B_REGISTER_MAX_ATTEMPTS=120
