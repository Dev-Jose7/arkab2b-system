# Copy this file to platform/stack/.env and adjust values if needed.

# Shared infrastructure host ports
ARKAB2B_POSTGRES_PORT=55432
ARKAB2B_REDIS_PORT=56379
ARKAB2B_KAFKA_PORT=59092
ARKAB2B_KAFKA_ADVERTISED_HOST=localhost
ARKAB2B_PUBLIC_BIND_ADDRESS=0.0.0.0
ARKAB2B_PRIVATE_BIND_ADDRESS=0.0.0.0

# Control-plane ports
ARKAB2B_CONFIG_SERVER_PORT=8888
ARKAB2B_EUREKA_SERVER_PORT=8761
ARKAB2B_API_GATEWAY_PORT=8080

# Service ports
ARKAB2B_IAM_PORT=8081
ARKAB2B_DIRECTORY_PORT=8082
ARKAB2B_CATALOG_PORT=8083
ARKAB2B_INVENTORY_PORT=8084
ARKAB2B_ORDER_PORT=8085
ARKAB2B_NOTIFICATION_PORT=8086
ARKAB2B_REPORTING_PORT=8087

# Optional startup behavior
ARKAB2B_READY_MAX_ATTEMPTS=240
ARKAB2B_REGISTER_MAX_ATTEMPTS=120
ARKAB2B_RUN_SMOKE=false

# Local secret material (Phase 5)
APP_LOCAL_SECRETS_DIR=./platform/secrets/local
APP_SECRETS_HOST_DIR=./platform/secrets/local
# APP_SECURITY_JWT_PRIVATE_KEY_PATH=file:./platform/secrets/local/identity-access-private.pem
# APP_SECURITY_JWT_PUBLIC_KEY_PATH=file:./platform/secrets/local/identity-access-public.pem
